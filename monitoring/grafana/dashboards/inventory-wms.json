{
  "id": null,
  "uid": "inventory-wms",
  "title": "Inventory WMS — Runtime",
  "tags": ["inventory", "spring-boot"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP Requests / sec",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"inventory-management\"}[1m])) by (uri, method, status)",
          "legendFormat": "{{method}} {{uri}} [{{status}}]",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP P99 Latency (ms)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"inventory-management\"}[1m])) by (le, uri)) * 1000",
          "legendFormat": "{{uri}} p99",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "JVM Heap Used",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"inventory-management\", area=\"heap\"}",
          "legendFormat": "{{id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "id": 4,
      "title": "Active DB Connections",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"inventory-management\"}",
          "legendFormat": "Active",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_pending{application=\"inventory-management\"}",
          "legendFormat": "Pending",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "HTTP Error Rate %",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"inventory-management\", status=~\"5..\"}[1m])) / sum(rate(http_server_requests_seconds_count{application=\"inventory-management\"}[1m])) * 100",
          "legendFormat": "5xx %",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    }
  ]
}
