# Copy to ".env" next to docker-compose.yml and change the values. ".env" is git-ignored: never commit it.
# Every value below is a PLACEHOLDER. `docker compose up` also works without a .env file, using the
# clearly marked development defaults from docker-compose.yml (demo only, never for a real deployment).

# Signing key for the login JWT. At least 32 bytes, random. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-bytes

# PostgreSQL password. It is applied when the database volume is first created; to change it for an
# existing database, change it in PostgreSQL as well.
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Grafana admin password (http://localhost:3001).
GRAFANA_PASSWORD=replace-with-a-strong-grafana-password

# Serve Swagger UI / OpenAPI (ADMIN login required). Set to false for anything but a local demo.
APP_DOCS_ENABLED=true

# Everything runs in UTC; leave as is.
TZ=UTC

# Host port for Grafana if 3001 is already used by another app (default 3001).
# GRAFANA_PORT=3003

# Web app host port and the matching allowed browser origin, if 3002 is already used.
# INVENTORY_PORT=3004
# APP_CORS_ALLOWED_ORIGINS=http://localhost:3004

# Host port for Prometheus if 9090 is already used (default 9090).
# PROMETHEUS_PORT=9091
